#include <windows.h>
#include "@FONTMAKER_RESOURCE_H@"

// windres cannot parse the 0x80000000L form used by some SDK headers.
#undef IDC_STATIC
#define IDC_STATIC -1

#pragma code_page(65001)

IDI_APP ICON "@FONTMAKER_ICON_PATH@"
IDB_LOGO BITMAP "@FONTMAKER_LOGO_PATH@"

1 RT_MANIFEST "@FONTMAKER_MANIFEST_PATH@"

IDD_MAIN DIALOGEX 0, 0, 440, 344
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "FontMaker @PROJECT_VERSION@"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "预览", IDC_STATIC, 7, 7, 258, 300
    CONTROL         "", IDC_PREVIEW, "Static", SS_OWNERDRAW, 14, 20, 244, 280
    EDITTEXT        IDC_INDEX, 14, 312, 180, 14, ES_AUTOHSCROLL | ES_READONLY
    CONTROL         "", IDC_SPIN_INDEX, "msctls_updown32", UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 194, 312, 11, 14
    LTEXT           "", IDC_STATUS, 14, 328, 244, 10, SS_NOPREFIX | SS_ENDELLIPSIS
    PUSHBUTTON      "关于", IDC_ABOUT, 218, 312, 44, 16
    DEFPUSHBUTTON   "保存字库", IDC_SAVE, 272, 318, 161, 18

    GROUPBOX        "字体设置", IDC_STATIC, 270, 7, 163, 60
    LTEXT           "字体:", IDC_STATIC, 277, 22, 22, 10
    COMBOBOX        IDC_FONT_LIST, 302, 18, 124, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "字号:", IDC_STATIC, 277, 40, 22, 10
    EDITTEXT        IDC_FONT_SIZE, 302, 36, 34, 14, ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "", IDC_SPIN_SIZE, "msctls_updown32", UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_SETBUDDYINT | UDS_NOTHOUSANDS, 337, 36, 11, 14
    LTEXT           "字形:", IDC_STATIC, 354, 40, 22, 10
    COMBOBOX        IDC_FONT_STYLE, 379, 36, 47, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "字符集", IDC_STATIC, 270, 73, 163, 62
    CONTROL         "标准字库", IDC_STD, "Button", BS_AUTORADIOBUTTON | WS_GROUP, 277, 87, 55, 10
    COMBOBOX        IDC_CHARSET_LIST, 336, 84, 90, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "用户定义", IDC_USER, "Button", BS_AUTORADIOBUTTON, 277, 102, 55, 10
    PUSHBUTTON      "编辑码表", IDC_EDIT_TABLE, 336, 100, 90, 14
    CONTROL         "去重", IDC_STD_DEDUPE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 277, 117, 55, 10

    GROUPBOX        "点阵大小", IDC_STATIC, 270, 141, 77, 62
    LTEXT           "宽:", IDC_STATIC, 277, 157, 14, 10
    EDITTEXT        IDC_WIDTH, 293, 153, 28, 14, ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "", IDC_SPIN_WIDTH, "msctls_updown32", UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_SETBUDDYINT | UDS_NOTHOUSANDS, 322, 153, 11, 14
    LTEXT           "高:", IDC_STATIC, 277, 174, 14, 10
    EDITTEXT        IDC_HEIGHT, 293, 170, 28, 14, ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "", IDC_SPIN_HEIGHT, "msctls_updown32", UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_SETBUDDYINT | UDS_NOTHOUSANDS, 322, 170, 11, 14

    GROUPBOX        "位置偏移", IDC_STATIC, 356, 141, 77, 62
    LTEXT           "X:", IDC_STATIC, 361, 157, 18, 10
    EDITTEXT        IDC_OFFSET_X, 384, 153, 26, 14, ES_AUTOHSCROLL
    CONTROL         "", IDC_SPIN_OFFSET_X, "msctls_updown32", UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_SETBUDDYINT | UDS_NOTHOUSANDS, 411, 153, 11, 14
    LTEXT           "Y:", IDC_STATIC, 361, 174, 18, 10
    EDITTEXT        IDC_OFFSET_Y, 384, 170, 26, 14, ES_AUTOHSCROLL
    CONTROL         "", IDC_SPIN_OFFSET_Y, "msctls_updown32", UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_SETBUDDYINT | UDS_NOTHOUSANDS, 411, 170, 11, 14

    GROUPBOX        "扫描方式", IDC_STATIC, 270, 209, 77, 44
    CONTROL         "水平", IDC_SCAN_H, "Button", BS_AUTORADIOBUTTON | WS_GROUP, 277, 221, 58, 10
    CONTROL         "垂直", IDC_SCAN_V, "Button", BS_AUTORADIOBUTTON, 277, 236, 58, 10

    GROUPBOX        "比特顺序", IDC_STATIC, 356, 209, 77, 44
    CONTROL         "高位在前", IDC_MSB, "Button", BS_AUTORADIOBUTTON | WS_GROUP, 361, 221, 58, 10
    CONTROL         "低位在前", IDC_LSB, "Button", BS_AUTORADIOBUTTON, 361, 236, 58, 10

    GROUPBOX        "字符宽度", IDC_STATIC, 270, 259, 77, 44
    CONTROL         "固定宽度", IDC_FIXED, "Button", BS_AUTORADIOBUTTON | WS_GROUP, 277, 271, 58, 10
    CONTROL         "可变宽度", IDC_VARIABLE, "Button", BS_AUTORADIOBUTTON, 277, 286, 58, 10

    GROUPBOX        "文件格式", IDC_STATIC, 356, 259, 77, 55
    CONTROL         "C 文件", IDC_FORMAT_C, "Button", BS_AUTORADIOBUTTON | WS_GROUP, 361, 271, 58, 10
    CONTROL         "BIN 文件", IDC_FORMAT_BIN, "Button", BS_AUTORADIOBUTTON, 361, 286, 58, 10
    CONTROL         "JSON 元数据", IDC_METADATA, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 361, 299, 58, 10
END

IDD_CHARSET_EDITOR DIALOGEX 0, 0, 400, 238
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "自定义码表"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_TABLE_TEXT, 7, 7, 386, 180, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP, WS_EX_CLIENTEDGE
    CONTROL         "去重", IDC_DEDUPE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 194, 50, 10
    CONTROL         "过滤控制字符", IDC_FILTER_CONTROLS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 62, 194, 100, 10
    LTEXT           "0 个字符", IDC_CHAR_COUNT, 290, 194, 103, 10, SS_RIGHT
    PUSHBUTTON      "载入...", IDC_LOAD, 7, 214, 55, 16
    PUSHBUTTON      "保存...", IDC_SAVE_TEXT, 67, 214, 55, 16
    PUSHBUTTON      "插入数字", IDC_INSERT_DIGITS, 127, 214, 55, 16
    PUSHBUTTON      "插入字母", IDC_INSERT_LETTERS, 187, 214, 55, 16
    PUSHBUTTON      "取消", IDCANCEL, 300, 214, 44, 16
    DEFPUSHBUTTON   "完成", IDOK, 350, 214, 44, 16
END

IDD_ABOUT DIALOGEX 0, 0, 260, 170
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "关于 FontMaker"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_LOGO, "Static", SS_BITMAP | SS_CENTERIMAGE, 7, 7, 80, 80
    EDITTEXT        IDC_VERSION, 94, 7, 159, 80, ES_MULTILINE | ES_READONLY | ES_WANTRETURN | WS_VSCROLL
    EDITTEXT        IDC_LICENSE, 7, 94, 246, 50, ES_MULTILINE | ES_READONLY | ES_WANTRETURN | WS_VSCROLL
    DEFPUSHBUTTON   "确定", IDOK, 100, 150, 60, 16
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "FontMaker contributors"
            VALUE "FileDescription", "Bitmap font generator"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "FontMaker"
            VALUE "LegalCopyright", "Original author: Xingchen Didong; refactored 2026"
            VALUE "OriginalFilename", "FontMaker.exe"
            VALUE "ProductName", "FontMaker"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
